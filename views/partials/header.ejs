<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Question Paper System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">🛡️ SECURE-QPMS</a>
      <div class="d-flex align-items-center text-white">
        <% if (session && session.user) { %>
          <span class="me-3">User: <strong><%= session.user %></strong> (<%= session.role %>)</span>
          <a href="/logout" class="btn btn-sm btn-outline-danger">Logout</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <% if (messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert alert-<%= msg.category %> alert-dismissible fade show" role="alert">
          <%= msg.text %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    <% } %>
